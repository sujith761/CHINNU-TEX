const q = query(
  collection(db, 'weavingPrices'),
  where('isActive', '==', true),
  orderBy('pricePerMetre')
);

const snapshot = await getSnapshot(q);

const data = snapshot.docs.map(doc => ({
  id: doc.id,
  name: doc.data().name,
  pricePerMetre: doc.data().pricePerMetre,
  isActive: doc.data().isActive
}));

console.log(data);